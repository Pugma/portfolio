---
import { getCollection, render } from "astro:content";
import MarkdownContent from "../../components/MarkdownContent.astro";
import Layout from "../../layouts/Layout.astro";
import { getPostThumbnail } from "../../lib/post-thumbnail";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { post: post.data.date.toISOString().split("T")[0] },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const thumbnail = getPostThumbnail(post.id);
const description = post.body?.slice(0, 100) ?? post.data.title;
---

<Layout
  pageTitle={post.data.title}
  description={description}
  image={thumbnail?.src}
  type="article"
>
  <h1>{post.data.title}</h1>
  <p>公開日: {post.data.date.toISOString().split("T")[0]}</p>
  {
    post.data.updatedDate && (
      <p>更新日: {post.data.updatedDate.toISOString().split("T")[0]}</p>
    )
  }

  <MarkdownContent>
    <Content />
  </MarkdownContent>
</Layout>
