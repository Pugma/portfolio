---
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import { externalPosts } from "../../data/external-posts";
import { getOgpPreview } from "../../lib/ogp";
import { getPostThumbnail } from "../../lib/post-thumbnail";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("posts").then((posts) => {
  posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts;
});

const externalPostPreviews = await Promise.all(
  externalPosts.map(async ({ publishedAt, url }) => ({
    publishedAt,
    entries: await Promise.all(url.toReversed().map(getOgpPreview)),
  })),
);

---

<Layout
  pageTitle="投稿一覧"
  description="ぷぐまが公開した記事の一覧です。"
>
  <h1>Posts</h1>
  {
    posts.length ? (
      <div class="flex flex-col gap-2">
        {posts.map((post) => {
          const thumbnail = getPostThumbnail(post.id);
          const date = post.data.date.toISOString().split("T")[0];

          return (
            <a href={`/posts/${date}`} class="post-card-link">
              <PostCard
                title={`${date} - ${post.data.title}`}
                description={`${post.body?.slice(0, 100)}...`}
                image={thumbnail}
              />
            </a>
          );
        })}
      </div>
    ) : (
      <p>記事はまだ投稿されていません</p>
    )
  }

  <section>
    <h2>外部で公開している記事</h2>
    <div class="flex flex-col gap-4">
      {
        externalPostPreviews.map(({ publishedAt, entries }) => (
          <h3>{publishedAt}</h3>
          <ul class="flex flex-col gap-2 p-0">
          {
            entries.map(({ url, title, description, image }) => (
              <li class="list-none">
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="post-card-link"
                >
                  <PostCard
                    title={title}
                    description={description}
                    image={image}
                  />
                </a>
              </li>
            ))
          }
          </ul>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  a.post-card-link,
  a.post-card-link:visited,
  a.post-card-link:hover,
  a.post-card-link:active {
    display: block;
    color: inherit;
    text-decoration: none;
  }
</style>
