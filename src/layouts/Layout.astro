---
import Header from "../components/header.astro";
import "../styles/global.css";

interface Props {
  pageTitle?: string;
  description?: string;
  image?: string;
  type?: "article" | "website";
}

const {
  pageTitle,
  description = "ぷぐまの個人サイト (Portfolio) です。",
  image = "/Pugma.png",
  type = "website",
} = Astro.props;

const title = pageTitle ? `${pageTitle} | ぷぐま Portfolio` : "ぷぐま Portfolio";
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />

    <title>{title}</title>
    <meta name="author" content="Pugma" />
    <meta name="description" content={description} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/vnd.microsoft.icon" href="/favicon.ico" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed"
      href="/posts/rss.xml"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;

    background-color: var(--color-background);
    color: var(--color-text);
  }

  main {
    height: calc(100vh - 80px);
    max-width: 1080px;
    margin: 0 auto;
    padding: 8px 16px;

    overflow-y: auto;
  }
</style>
